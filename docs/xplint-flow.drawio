<mxfile host="app.diagrams.net"><diagram name="flow" id="flow"><mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="1400" math="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="xplint: how a lint run flows (follow 1 to 8)" style="text;html=1;fontSize=26;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="200" y="20" width="760" height="40" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b style=&quot;font-size:16px&quot;&gt;Inputs&lt;/b&gt;&lt;br&gt;Files, dirs, stdin&lt;br&gt;&lt;i style=&quot;color:#555&quot;&gt;e.g. compositions/*.yaml&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2f5597;strokeWidth=2;fontSize=12;spacingLeft=60;spacingRight=60;align=left;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="560" height="92" as="geometry"/></mxCell><mxCell id="b1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1f4e9c;strokeColor=#ffffff;fontColor=#ffffff;fontSize=24;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="308" y="112.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t1" value="S3" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#b38f00;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="808" y="96" width="44" height="22" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b style=&quot;font-size:16px&quot;&gt;Parse&lt;/b&gt;&lt;br&gt;Reads every YAML document (multi-doc), keeps line numbers&lt;br&gt;&lt;i style=&quot;color:#555&quot;&gt;e.g. serde_yaml splits a.yaml into 3 docs&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2f5597;strokeWidth=2;fontSize=12;spacingLeft=60;spacingRight=60;align=left;" vertex="1" parent="1"><mxGeometry x="300" y="222" width="560" height="92" as="geometry"/></mxCell><mxCell id="b2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1f4e9c;strokeColor=#ffffff;fontColor=#ffffff;fontSize=24;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="308" y="244.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t2" value="S1" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#b38f00;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="808" y="228" width="44" height="22" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#1f4e9c;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b style=&quot;font-size:16px&quot;&gt;Typed models&lt;/b&gt;&lt;br&gt;Turns documents into XRD / Composition / Function structs&lt;br&gt;&lt;i style=&quot;color:#555&quot;&gt;e.g. kind: Composition -&gt; Composition model&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2f5597;strokeWidth=2;fontSize=12;spacingLeft=60;spacingRight=60;align=left;" vertex="1" parent="1"><mxGeometry x="300" y="354" width="560" height="92" as="geometry"/></mxCell><mxCell id="b3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1f4e9c;strokeColor=#ffffff;fontColor=#ffffff;fontSize=24;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="308" y="376.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t3" value="S1" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#b38f00;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="808" y="360" width="44" height="22" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#1f4e9c;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b style=&quot;font-size:16px&quot;&gt;Pack router&lt;/b&gt;&lt;br&gt;Picks which rules apply: core always, aws pack if apiVersion group rds.aws.upbound.io&lt;br&gt;&lt;i style=&quot;color:#555&quot;&gt;e.g. rds.aws.upbound.io/v1beta1 Instance -&gt; aws pack&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2f5597;strokeWidth=2;fontSize=12;spacingLeft=60;spacingRight=60;align=left;" vertex="1" parent="1"><mxGeometry x="300" y="486" width="560" height="92" as="geometry"/></mxCell><mxCell id="b4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1f4e9c;strokeColor=#ffffff;fontColor=#ffffff;fontSize=24;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="308" y="508.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t4" value="S2" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#b38f00;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="808" y="492" width="44" height="22" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#1f4e9c;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b style=&quot;font-size:16px&quot;&gt;Rule engine&lt;/b&gt;&lt;br&gt;Runs every active rule on every model&lt;br&gt;&lt;i style=&quot;color:#555&quot;&gt;Core rules: on by default; any rule can be disabled via rules: in .xplint.yaml&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2f5597;strokeWidth=2;fontSize=12;spacingLeft=60;spacingRight=60;align=left;" vertex="1" parent="1"><mxGeometry x="300" y="618" width="560" height="92" as="geometry"/></mxCell><mxCell id="b5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1f4e9c;strokeColor=#ffffff;fontColor=#ffffff;fontSize=24;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="308" y="640.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t5" value="S2" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#b38f00;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="808" y="624" width="44" height="22" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#1f4e9c;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b style=&quot;font-size:16px&quot;&gt;Diagnostics&lt;/b&gt;&lt;br&gt;Collects findings with rule id, severity, file:line&lt;br&gt;&lt;i style=&quot;color:#555&quot;&gt;e.g. error core/001 comp.yaml:14&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2f5597;strokeWidth=2;fontSize=12;spacingLeft=60;spacingRight=60;align=left;" vertex="1" parent="1"><mxGeometry x="300" y="750" width="560" height="92" as="geometry"/></mxCell><mxCell id="b6" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1f4e9c;strokeColor=#ffffff;fontColor=#ffffff;fontSize=24;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="308" y="772.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t6" value="S2" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#b38f00;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="808" y="756" width="44" height="22" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#1f4e9c;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b style=&quot;font-size:16px&quot;&gt;Output&lt;/b&gt;&lt;br&gt;Prints the findings in the chosen format&lt;br&gt;&lt;i style=&quot;color:#555&quot;&gt;text | json | SARIF&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2f5597;strokeWidth=2;fontSize=12;spacingLeft=60;spacingRight=60;align=left;" vertex="1" parent="1"><mxGeometry x="300" y="882" width="560" height="92" as="geometry"/></mxCell><mxCell id="b7" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1f4e9c;strokeColor=#ffffff;fontColor=#ffffff;fontSize=24;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="308" y="904.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t7" value="S4" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#b38f00;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="808" y="888" width="44" height="22" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#1f4e9c;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s8" value="&lt;b style=&quot;font-size:16px&quot;&gt;Exit code&lt;/b&gt;&lt;br&gt;Tells CI whether the run passed&lt;br&gt;&lt;i style=&quot;color:#555&quot;&gt;0 clean, 1 errors found, 2 usage/IO error&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2f5597;strokeWidth=2;fontSize=12;spacingLeft=60;spacingRight=60;align=left;" vertex="1" parent="1"><mxGeometry x="300" y="1014" width="560" height="92" as="geometry"/></mxCell><mxCell id="b8" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1f4e9c;strokeColor=#ffffff;fontColor=#ffffff;fontSize=24;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="308" y="1036.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t8" value="S3" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#b38f00;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="808" y="1020" width="44" height="22" as="geometry"/></mxCell><mxCell id="e8" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#1f4e9c;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cfg" value="&lt;b&gt;Config&lt;/b&gt;&lt;br&gt;.xplint.yaml (rules:, packs:)&lt;br&gt;inline xplint-ignore comments" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="613" width="250" height="102" as="geometry"/></mxCell><mxCell id="ecfg" style="edgeStyle=none;html=1;dashed=1;endArrow=block;strokeWidth=2;strokeColor=#666;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cfg" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rend" value="&lt;b&gt;crossplane render&lt;/b&gt;&lt;br&gt;optional, stage 5&lt;br&gt;feeds step 1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff;strokeColor=#666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-30" y="96" width="230" height="80" as="geometry"/></mxCell><mxCell id="erend" style="edgeStyle=none;html=1;dashed=1;endArrow=block;strokeWidth=2;strokeColor=#666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rend" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="crd" value="&lt;b&gt;CRD-aware checks&lt;/b&gt;&lt;br&gt;optional, stage 5&lt;br&gt;field-level schema checks" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff;strokeColor=#666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-30" y="624" width="230" height="80" as="geometry"/></mxCell><mxCell id="ecrd" style="edgeStyle=none;html=1;dashed=1;endArrow=block;strokeWidth=2;strokeColor=#666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="crd" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=0;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fff;strokeColor=#999;" vertex="1" parent="1"><mxGeometry x="930" y="882" width="250" height="120" as="geometry"/></mxCell><mxCell id="l1" style="endArrow=block;strokeWidth=3;strokeColor=#1f4e9c;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="924" as="sourcePoint"/><mxPoint x="1005" y="924" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l1t" value="solid = core path" style="text;html=1;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1015" y="912" width="150" height="24" as="geometry"/></mxCell><mxCell id="l2" style="endArrow=block;dashed=1;strokeWidth=2;strokeColor=#666;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="954" as="sourcePoint"/><mxPoint x="1005" y="954" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l2t" value="dashed = optional / config" style="text;html=1;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1015" y="942" width="160" height="24" as="geometry"/></mxCell><mxCell id="l3t" value="S1..S5 = roadmap stage" style="text;html=1;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="970" width="200" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>