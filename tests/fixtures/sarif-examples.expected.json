{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "xplint",
          "version": "@VERSION@",
          "informationUri": "https://github.com/miqui/xplint",
          "rules": [
            {
              "id": "xrd-required-without-default",
              "shortDescription": {
                "text": "XRD spec field listed in required has no schema default"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "composition-missing-function",
              "shortDescription": {
                "text": "Pipeline step references a function that no loaded Function declares"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "composition-missing-deletion-policy",
              "shortDescription": {
                "text": "Composed resource sets neither deletionPolicy nor managementPolicies"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "patch-path-not-in-xrd",
              "shortDescription": {
                "text": "Patch fromFieldPath/toFieldPath is not defined in the XRD schema"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "composition-missing-deletion-policy",
          "ruleIndex": 2,
          "level": "warning",
          "message": {
            "text": "composed resource 'bucket' sets neither deletionPolicy nor managementPolicies"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/violations/missing-deletion-policy/composition.yaml"
                },
                "region": {
                  "startLine": 22
                }
              }
            }
          ]
        },
        {
          "ruleId": "composition-missing-function",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "step 'patch-and-transform' references function 'function-not-installed' which is not declared by any loaded Function"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/violations/missing-function/composition.yaml"
                },
                "region": {
                  "startLine": 20
                }
              }
            }
          ]
        },
        {
          "ruleId": "patch-path-not-in-xrd",
          "ruleIndex": 3,
          "level": "error",
          "message": {
            "text": "path 'spec.sizee' is not defined in the XRD schema"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/violations/patch-path-not-in-xrd/database.yaml"
                },
                "region": {
                  "startLine": 56
                }
              }
            }
          ]
        },
        {
          "ruleId": "patch-path-not-in-xrd",
          "ruleIndex": 3,
          "level": "error",
          "message": {
            "text": "path 'status.endpoint' is not defined in the XRD schema"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/violations/patch-path-not-in-xrd/database.yaml"
                },
                "region": {
                  "startLine": 60
                }
              }
            }
          ]
        },
        {
          "ruleId": "xrd-required-without-default",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "field 'spec.region' is required but has no default"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/violations/required-without-default/xrd.yaml"
                },
                "region": {
                  "startLine": 22
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
